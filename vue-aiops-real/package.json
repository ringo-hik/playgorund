{
  "name": "vue-aiops-real",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "prepare": "cypress install",
    "test:e2e": "playwright test",
    "test:e2e:dev": "start-server-and-test 'vite dev --port 4173' http://localhost:4173 'cypress open --e2e'",
    "test:automation": "node playwright-automation-workflow.js",
    "test:comprehensive": "playwright test tests/comprehensive-e2e-test.spec.ts",
    "test:capture": "playwright test tests/advanced-capture-workflow.spec.ts",
    "test:reports": "playwright test tests/markdown-report-generator.spec.ts",
    "test:all": "playwright test --reporter=html",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "build-only": "vite build",
    "type-check": "vue-tsc --build"
  },
  "dependencies": {
    "@iconify-icons/uil": "^1.2.3",
    "@iconify/vue": "^5.0.0",
    "axios": "^1.10.0",
    "pinia": "^3.0.3",
    "playwright": "^1.54.1",
    "unicons": "^0.0.3",
    "vue": "^3.5.17",
    "vue-router": "^4.5.1",
    "vue-unicons": "^3.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.1",
    "@tsconfig/node22": "^22.0.2",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.15.32",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitejs/plugin-vue-jsx": "^5.0.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "cypress": "^14.5.0",
    "jsdom": "^26.1.0",
    "npm-run-all2": "^8.0.4",
    "start-server-and-test": "^2.0.12",
    "typescript": "~5.8.0",
    "vite": "^7.0.0",
    "vite-plugin-vue-devtools": "^7.7.7",
    "vitest": "^3.2.4",
    "vue-tsc": "^2.2.10"
  }
}